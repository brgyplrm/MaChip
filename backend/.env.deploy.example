# ==============================================================================
# MACHIP PRODUCTION / DEPLOYMENT ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions:
# 1. Place this file as `backend/.env` on the MAC-J Mini PC / Production Server.
# 2. Set strong, unique production secrets and secure database credentials.
# 3. Ensure NODE_ENV is set to production.
# 4. NEVER commit active .env files with real credentials to GitHub.
# ==============================================================================

# --- NETWORK & ZERO-CONFIG DISCOVERY ---
PORT=4000
UDP_PORT=4001
# UDP_DISCOVERY_HOST=192.168.1.11 # Optional static IP override; auto-detected if omitted

# --- DATABASE CONFIG (PRODUCTION TARGET) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=machip
DB_PASSWORD=your_secure_production_db_password
DB_DATABASE=machipdb

# --- SYSTEM SETTINGS ---
NODE_ENV=production
TZ=Asia/Manila

# --- EMAIL SERVICE (PRODUCTION NOTIFICATIONS) ---
EMAIL_SERVICE=gmail
EMAIL_USER=your_production_mailer@gmail.com
EMAIL_PASS="your_production_gmail_app_password"

# --- JWT & SYSTEM SECURITY ---
JWT_SECRET=your_production_jwt_secret_min_64_characters
ENCRYPTION_KEY="your_production_32_hex_encryption_key"

# --- ESP32 HARDWARE SHARED SECRETS ---
# Note: These must match the values flashed into the production ESP32 hardware
ESP32_API_KEY="your_production_esp32_api_key_64_hex_chars"
SECRET_HMAC_KEY="your_production_secret_hmac_key_64_hex_chars"
ESP32_AES_KEY="your_production_16_byte_aes"
