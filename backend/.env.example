# ==============================================================================
# MACHIP LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to `backend/.env`:
# 2. Update with your local database credentials and shared hardware keys.
# 3. For production deployment on the Mini PC, refer to `.env.deploy.example`.
# 4. NEVER commit active .env files with real credentials to GitHub.
# ==============================================================================

# --- NETWORK & ZERO-CONFIG DISCOVERY ---
PORT=4000
UDP_PORT=4001
# UDP_DISCOVERY_HOST=192.168.1.11 # Optional manual override; auto-detected if omitted

# --- DATABASE CONFIG (LOCAL DEVELOPMENT TARGET) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=machip
DB_PASSWORD=your_local_postgres_password
DB_DATABASE=machipdb_dev

# --- SYSTEM SETTINGS ---
NODE_ENV=development
TZ=Asia/Manila

# --- EMAIL SERVICE (OPTIONAL FOR LOCAL DEV) ---
EMAIL_SERVICE=gmail
EMAIL_USER=your_dev_email@gmail.com
EMAIL_PASS="your_gmail_app_password"

# --- JWT & SYSTEM SECURITY (GENERATE STRONG SECRETS FOR YOUR ENVIRONMENT) ---
JWT_SECRET=your_dev_jwt_secret_min_32_characters
ENCRYPTION_KEY="your_32_character_hex_aes_key"

# --- ESP32 HARDWARE SHARED SECRETS ---
# Note: These must match the values defined in firmware/MaChip_Test/arduino_secrets.h
ESP32_API_KEY="your_esp32_shared_api_key_64_hex_chars"
SECRET_HMAC_KEY="your_esp32_shared_hmac_key_64_hex_chars"
ESP32_AES_KEY="your_16_byte_aes"
