{
  "name": "machip-root",
  "version": "1.0.0",
  "description": "Root for MaChip Project",
  "scripts": {
    "reset": "npm run reset:backend && npm run reset:frontend && npm install",
    "reset:backend": "rimraf backend/node_modules backend/package-lock.json && npm install --prefix backend",
    "reset:frontend": "rimraf frontend/node_modules frontend/package-lock.json && npm install --prefix frontend --legacy-peer-deps",
    "db:reset": "npm run db:reset --prefix backend",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "env:dev": "node scripts/switch_env.js dev",
    "env:prod": "node scripts/switch_env.js prod",
    "env:status": "node scripts/switch_env.js status",
    "ota": "python scripts/ota_flash.py",
    "ota:build": "python scripts/ota_flash.py --compile",
    "update:all": "node scripts/safe_update_all.js",
    "test:guardrails": "node scripts/verify_employee_guardrails.js",
    "test:november": "node scripts/verify_november_payroll_suite.js",
    "test:modules": "node scripts/verify_modules_suite.js",
    "test:payroll": "node scripts/verify_payroll_comprehensive_suite.js",
    "test:email": "node scripts/verify_email_service.js",
    "test:settings": "node scripts/verify_settings_suite.js",
    "test:auth": "node scripts/verify_auth_first_login_suite.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.2",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.12",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bullmq": "^5.71.1",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.10.1",
    "jspdf": "^4.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4"
  }
}
